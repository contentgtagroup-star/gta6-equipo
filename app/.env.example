# Copiá este archivo como app/.env.local (o cargá las mismas variables en Vercel).
# No subas nunca valores reales al repositorio.

# --- Base de datos (Supabase) ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_KEY=service_role-key
# Claves del equipo en JSON: {"Nombre":"clave-larga-1","Otro":"clave-larga-2"}
TEAM_KEYS={}

# --- Radar de Twitch ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Publicaciones (opcional hasta habilitar envíos) ---
# Origen HTTPS del panel, sin barra final.
PUBLICACION_ORIGIN=https://tu-panel.vercel.app
# 32 bytes aleatorios en base64: openssl rand -base64 32
PUBLICACION_CIPHER_KEY=
# Dejar vacío durante la configuración. Poner 1 recién cuando las cuentas estén probadas.
PUBLICACION_ACTIVA=

# --- Meta (Instagram + Facebook) ---
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_GRAPH_VERSION=v27.0

# --- YouTube (Google Cloud) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_CHANNEL_ID=

# --- TikTok ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- X vía Buffer ---
BUFFER_API_KEY=
BUFFER_CHANNEL_ID=
BUFFER_ORGANIZATION_ID=
